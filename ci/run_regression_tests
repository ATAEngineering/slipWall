#!/bin/bash

pwd
export cwd=`pwd`
ls -lh
export MAGIC_DIR=$cwd/modules/magic
export MAGIC_THERMO_DIR=$MAGIC_DIR/thermodynamics
export MAGIC_TRANSPORT_DIR=$MAGIC_DIR/transport
echo "LOCI_BASE" $LOCI_BASE
echo "CHEM_BASE" $CHEM_BASE
echo "CHEMISTRY_DATABASE" $CHEMISTRY_DATABASE
export LOCI_MODULE_PATH=$cwd:$cwd/modules:$MAGIC_DIR/lib
export LD_LIBRARY_PATH=$LOCI_MODULE_PATH:$LD_LIBRARY_PATH
export COLLISION_INTEGRAL_DATABASE=$cwd/modules/collisionIntegrals
export OMPI_MCA_btl_vader_single_copy_mechanism=none
which extract
which chem
cd testCases
python3 -u regressionTests.py -n ${1}
result=$?
echo "Error code" $result
if (( $result != 0 ))
then
  echo "Regression tests had an error"
  exit $result
fi
